# STAR works with a locally running model. NO PAID MODEL API KEY REQUIRED.
STAR_MODEL=your-loaded-lm-studio-model-id
STAR_BASE_URL=http://127.0.0.1:1234/v1
STAR_MAX_MODEL_CALLS=12
STAR_CONTEXT_CHARS=25000
# Discover via `python main.py studios`. Change after each Studio restart.
# Edit mode refuses all other Studio instances.
STAR_SANDBOX_STUDIO_ID=
# GitHub App, optional until you register/install it.
STAR_GITHUB_APP_ID=
STAR_GITHUB_INSTALLATION_ID=
# Must be a private key file stored OUTSIDE the repository folder.
STAR_GITHUB_PRIVATE_KEY_FILE=
STAR_GITHUB_REPO=your-username/star-core
# The star/<name> work branch STAR cuts its branches from and opens draft pull requests against.
# Required for publishing; main (the default branch) is always refused.
STAR_GITHUB_BASE_BRANCH=
