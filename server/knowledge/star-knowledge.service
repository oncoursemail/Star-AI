[Unit]
Description=STAR Knowledge (official docs search, Roblox API lookup, Luau static checks)
Documentation=file:/opt/star/knowledge/app/starkb/serve.py
After=network-online.target star-brain.service
Wants=network-online.target

[Service]
User=star
Group=star
WorkingDirectory=/opt/star/knowledge/app
Environment=PYTHONUNBUFFERED=1
Environment=STAR_KB_HOME=/opt/star/knowledge
Environment=STAR_BRAIN_URL=http://127.0.0.1:8080
Environment=STAR_BRAIN_KEY_FILE=/opt/star/secrets/api_keys
Environment=STAR_LUAU_TOOLS=/opt/star/knowledge/tools
# The search itself is one small matrix product; keep it off the cores the brain uses.
Environment=OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2
ExecStart=/opt/star/knowledge/venv/bin/python -m starkb serve --host 0.0.0.0 --port 8091
Restart=on-failure
RestartSec=5
Nice=5
MemoryMax=6G
TasksMax=128
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/star/knowledge/data
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
