# /etc/sudoers.d/star : the ONLY things STAR's dedicated host account may do as root, without a password.
#
# Install (as the owner, at the console; the first line validates, the second only runs if the syntax is valid):
#   sudo visudo -cf star-sudoers && sudo install -o root -g root -m 440 star-sudoers /etc/sudoers.d/star
# Remove:  sudo rm /etc/sudoers.d/star
#
# Before installing:
#   1. Run `sudo bash tune.sh apply` once (it installs /usr/local/sbin/star-host-tune, the path named below).
#   2. Create the dedicated account (README.md step 4). It must NOT be in the sudo, lxd, docker or adm groups. The name
#      "starops" is only the example used in the README; if you pick another name, change it on the two lines below.
#
# What the rules allow (and nothing else):
#   - star-host-tune with exactly one argument: status, apply or rollback. A rule that lists arguments only matches
#     that exact command line, so "star-host-tune apply --dry-run", "star-host-tune boot", "uninstall" or "lxc-notes"
#     are NOT allowed (the owner can still run them with their own sudo).
#   - restarting the STAR container "starai" (plain, or with --force when it hangs). Not stop, not exec, not delete,
#     not config set, not any other container, not any other lxc subcommand.
# The script path is root-owned (installed with mode 0755 into /usr/local/sbin); the script refuses to run as root if
# it or its folder becomes writable by anyone else.

Defaults:starops !setenv, !visiblepw, use_pty, env_reset

Cmnd_Alias STAR_HOST_TUNE = /usr/local/sbin/star-host-tune status, \
                            /usr/local/sbin/star-host-tune apply, \
                            /usr/local/sbin/star-host-tune rollback

Cmnd_Alias STAR_CONTAINER = /snap/bin/lxc restart starai, \
                            /snap/bin/lxc restart starai --force

starops ALL=(root) NOPASSWD: STAR_HOST_TUNE, STAR_CONTAINER
