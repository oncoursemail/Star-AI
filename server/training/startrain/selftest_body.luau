-- Self-test of the harness stand-ins: run with `python -m startrain selftest` (answer = an empty module).
local a, b = Vector3.new(1, 2, 3), Vector3.new(4, 5, 6)
check("Vector3 add", a + b == Vector3.new(5, 7, 9))
check("Vector3 sub", b - a == Vector3.new(3, 3, 3))
check("Vector3 scale both ways", a * 2 == Vector3.new(2, 4, 6) and 2 * a == Vector3.new(2, 4, 6))
check("Vector3 divide", Vector3.new(2, 4, 6) / 2 == a)
check("Vector3 dot", a:Dot(b) == 32)
check("Vector3 cross", Vector3.xAxis:Cross(Vector3.yAxis) == Vector3.zAxis)
check("Vector3 magnitude", Vector3.new(3, 4, 0).Magnitude == 5)
check("Vector3 unit", approx(Vector3.new(0, 0, 5).Unit.Z, 1))
check("Vector3 lerp", a:Lerp(b, 0.5) == Vector3.new(2.5, 3.5, 4.5))
check("Vector3 typeof", typeof(a) == "Vector3" and typeof(1) == "number" and typeof("x") == "string")
check("Vector2 basics", Vector2.new(3, 4).Magnitude == 5 and Vector2.new(1, 2) + Vector2.new(1, 1) == Vector2.new(2, 3))
check("Color3 fromRGB", Color3.fromRGB(255, 0, 51) == Color3.new(1, 0, 0.2))
check("UDim2 fromScale", UDim2.fromScale(0.5, 1).X.Scale == 0.5 and UDim2.fromOffset(10, 20).Y.Offset == 20)
check("UDim2 new and equality", UDim2.new(0, 10, 0, 20) == UDim2.fromOffset(10, 20))
check("UDim2 typeof", typeof(UDim2.new()) == "UDim2")
check("Enum items are stable", Enum.KeyCode.E == Enum.KeyCode.E and Enum.KeyCode.E ~= Enum.KeyCode.R and Enum.KeyCode.E.Name == "E")
local r1, r2 = Random.new(5), Random.new(5)
check("Random is deterministic", r1:NextInteger(1, 100) == r2:NextInteger(1, 100) and r1:NextNumber() == r2:NextNumber())

local root = Instance.new("Folder")
local part = Instance.new("Part")
local added, removed = 0, 0
root.ChildAdded:Connect(function() added += 1 end)
root.ChildRemoved:Connect(function() removed += 1 end)
part.Name = "Door"
part.Parent = root
check("Parent links both ways", part.Parent == root and root:FindFirstChild("Door") == part and root.Door == part)
check("ChildAdded fired", added == 1)
check("IsA follows the hierarchy", part:IsA("BasePart") and part:IsA("Instance") and not part:IsA("Model"))
check("part defaults", part.Anchored == false and part.Size == Vector3.new(4, 1, 2))
local clone = part:Clone()
check("Clone is separate", clone ~= part and clone.Parent == nil and clone.Name == "Door")
part.Parent = nil
check("reparent to nil", root:FindFirstChild("Door") == nil and removed == 1)
local child = Instance.new("Part", root)
child:Destroy()
check("Destroy removes and locks", #root:GetChildren() == 0 and throws(function() child.Parent = root end))
local gui = Instance.new("Frame")
check("GuiObject defaults", gui.Visible == true and gui.Size == UDim2.new(0, 0, 0, 0))
gui:SetAttribute("n", 3)
check("attributes", gui:GetAttribute("n") == 3 and gui:GetAttribute("missing") == nil)
local seen = {}
gui:GetPropertyChangedSignal("Visible"):Connect(function() table.insert(seen, gui.Visible) end)
gui.Visible = false
check("property changed signal", #seen == 1 and seen[1] == false)
local touchedWith
part.Touched:Connect(function(hit) touchedWith = hit end)
part.Touched:Fire(root)
check("events are Signals", touchedWith == root)
local remote = Instance.new("RemoteEvent")
remote:FireClient("p1", 1, 2)
remote:FireAllClients("x")
check("remote calls are recorded", #remote._calls == 2 and remote._calls[1].player == "p1" and remote._calls[1].args[2] == 2 and remote._calls[2].method == "FireAllClients")

local g = mockGame()
local players = g:GetService("Players")
local joined, left = {}, {}
players.PlayerAdded:Connect(function(p) table.insert(joined, p.Name) end)
players.PlayerRemoving:Connect(function(p) table.insert(left, p.Name) end)
local alice = mockPlayer("Alice", 1, 5)
alice.Character = mockCharacter(80)
players:AddPlayer(alice)
check("PlayerAdded", joined[1] == "Alice" and #players:GetPlayers() == 1)
check("GetPlayerFromCharacter", players:GetPlayerFromCharacter(alice.Character) == alice)
check("leaderstats", alice.leaderstats.Coins.Value == 5)
players:RemovePlayer(alice)
check("PlayerRemoving", left[1] == "Alice" and #players:GetPlayers() == 0)
check("GetService caches", g:GetService("RunService") == g:GetService("RunService") and g:GetService("Lighting").ClassName == "Lighting")
local stepped = 0
g:GetService("RunService").Heartbeat:Connect(function(dt) stepped += dt end)
g:GetService("RunService").Heartbeat:Fire(0.5)
check("Heartbeat is a Signal", stepped == 0.5)
local tagged = Instance.new("Part")
g:GetService("CollectionService"):AddTag(tagged, "Lamp")
check("CollectionService tags", tagged:HasTag("Lamp") and #g:GetService("CollectionService"):GetTagged("Lamp") == 1)
local tw = g:GetService("TweenService"):Create(gui, nil, { Visible = true })
tw:Play()
check("TweenService applies the goal", gui.Visible == true)
local closed = false
g:BindToClose(function() closed = true end)
g.__closers[1]()
check("BindToClose stores callbacks", closed)

local fine, env = load_answer({ game = g })
check("load_answer gives the answer's value and the game", type(fine) == "table" and env.game == g and env.workspace ~= nil)
check("deprecated globals are absent", env.wait == nil and env.spawn == nil and env.tick == nil and env.delay == nil)
check("task.wait returns at once", env.task.wait(1) == 1)
check("deepEqual", deepEqual({ 1, { a = 2 } }, { 1, { a = 2 } }) and not deepEqual({ 1 }, { 2 }))
