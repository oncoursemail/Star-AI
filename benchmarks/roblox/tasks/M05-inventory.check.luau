local Inventory = solution()
local inv = Inventory.new(10, 2)
check("add fills a new stack then another slot", function()
	expect(inv:add("wood", 15) == 15, "add wood 15")
	expect(inv:count("wood") == 15, "count wood")
end)
check("full slots refuse a new item", function()
	expect(inv:add("stone", 10) == 0, "stone should not fit")
	expect(inv:count("stone") == 0, "stone count")
end)
check("tops up existing stacks", function()
	expect(inv:add("wood", 3) == 3, "add 3")
	expect(inv:add("wood", 5) == 2, "only 2 fit")
	expect(inv:count("wood") == 20, "count 20")
end)
check("remove too many changes nothing", function()
	expect(inv:remove("wood", 21) == false, "remove 21 should fail")
	expect(inv:count("wood") == 20, "count changed")
end)
check("remove frees slots", function()
	expect(inv:remove("wood", 20) == true, "remove 20")
	expect(inv:count("wood") == 0, "count 0")
	expect(inv:add("stone", 20) == 20, "both slots free again")
end)
