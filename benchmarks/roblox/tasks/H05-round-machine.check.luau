local RoundManager = solution()
local rm = RoundManager.new({ Intermission = 5, Playing = 10, Ended = 3 })
local changes = {}
rm:onChanged(function(new, old) table.insert(changes, old .. ">" .. new) end)
check("starts in Intermission", function() expect(rm:state() == "Intermission", rm:state()) end)
check("small steps", function()
	rm:step(4)
	expect(rm:state() == "Intermission", "after 4 s: " .. rm:state())
	rm:step(1)
	expect(rm:state() == "Playing", "after 5 s: " .. rm:state())
end)
check("leftover carries over", function()
	rm:step(12)
	expect(rm:state() == "Ended", "after 17 s: " .. rm:state())
	rm:step(1)
	expect(rm:state() == "Intermission", "after 18 s: " .. rm:state())
end)
check("one big step crosses many states", function()
	local before = #changes
	rm:step(100)
	expect(rm:state() == "Playing", "after 118 s: " .. rm:state())
	expect(#changes - before == 16, "changes in the big step: " .. (#changes - before))
end)
check("callbacks in order", function()
	expect(changes[1] == "Intermission>Playing" and changes[2] == "Playing>Ended" and changes[3] == "Ended>Intermission",
		"order " .. table.concat(changes, ",", 1, math.min(3, #changes)))
end)
