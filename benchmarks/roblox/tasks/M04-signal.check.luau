local Signal = solution()
check("connect, fire, args", function()
	local s = Signal.new()
	local got
	s:Connect(function(a, b) got = { a, b } end)
	s:Fire(1, "x")
	task.wait()
	expect(got and got[1] == 1 and got[2] == "x", "handler did not get the arguments")
end)
check("same table, not a copy", function()
	local s = Signal.new()
	local t, got = {}, nil
	s:Connect(function(v) got = v end)
	s:Fire(t)
	task.wait()
	expect(rawequal(got, t), "the table arrived as a copy")
end)
check("disconnect", function()
	local s = Signal.new()
	local n = 0
	local c = s:Connect(function() n += 1 end)
	s:Fire()
	task.wait()
	c:Disconnect()
	s:Fire()
	task.wait()
	expect(n == 1, "called " .. n .. " times")
end)
check("once", function()
	local s = Signal.new()
	local n = 0
	s:Once(function() n += 1 end)
	s:Fire()
	s:Fire()
	task.wait()
	expect(n == 1, "called " .. n .. " times")
end)
check("wait returns the arguments", function()
	local s = Signal.new()
	task.delay(0.2, function() s:Fire("go", 5) end)
	local a, b = s:Wait()
	expect(a == "go" and b == 5, "Wait returned " .. tostring(a) .. ", " .. tostring(b))
end)
