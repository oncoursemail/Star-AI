local timeLeft = waitFor(function() return ROOT:FindFirstChild("TimeLeft", true) end, 10)
local status = ROOT:FindFirstChild("Status", true)
check("values exist", function()
	expect(timeLeft and timeLeft:IsA("IntValue"), "no IntValue TimeLeft")
	expect(status and status:IsA("StringValue"), "no StringValue Status")
end)
local first = timeLeft and timeLeft.Value or 0
local sw = stopwatch()
check("starts at 10 and Running", function()
	expect(first >= 8 and first <= 10, "start " .. first)
	expect(status.Value == "Running", "status at start " .. status.Value)
end)
check("ends at 0 with Status Ended", function()
	local ended = waitFor(function() return timeLeft.Value == 0 and status.Value == "Ended" end, 30)
	expect(ended, "TimeLeft " .. timeLeft.Value .. ", Status " .. status.Value)
	task.wait(1.5)
	expect(timeLeft.Value == 0, "went below 0")
end)
check("takes about a second per step", function()
	-- The wall clock never runs slower than game time, so a per-second countdown takes at least ~1 s per step
	-- of wall time even on a busy server; a per-frame countdown ends far sooner.
	local t = sw.read()
	expect(t.wall >= 0.6 * first, string.format("%d steps took %.1f s wall / %.1f s game", first, t.wall, t.game))
end)
