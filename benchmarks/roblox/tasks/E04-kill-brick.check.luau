local player, character, root = testPlayer()
local brick = waitFor(function() return ROOT:FindFirstChild("KillBrick", true) end, 10)
check("brick exists and is anchored", function()
	expect(brick and brick:IsA("BasePart") and brick.Anchored, "no anchored KillBrick")
	expect((brick.Position - Vector3.new(0, 40, 300)).Magnitude < 0.5, "position")
end)
check("touching kills", function()
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	expect(humanoid and humanoid.Health > 0, "character not alive at start")
	root.CFrame = CFrame.new(brick.Position + Vector3.new(0, 4, 0))
	local dead = waitFor(function() return humanoid.Health <= 0 end, 5)
	expect(dead, "still alive after standing on the brick")
end)
