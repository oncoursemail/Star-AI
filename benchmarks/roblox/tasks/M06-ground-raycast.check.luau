local M = solution()
local base = Vector3.new(2000, 100, 2000)
local floor = testPart({ Name = "Floor", Size = Vector3.new(20, 2, 20), Position = base + Vector3.new(0, -1, 0) })
local roof = testPart({ Name = "Roof", Size = Vector3.new(20, 1, 20), Position = base + Vector3.new(0, 10.5, 0) })
local model = Instance.new("Model")
model.Parent = ROOT
local inner = testPart({ Name = "Inner", Size = Vector3.new(20, 1, 20), Position = base + Vector3.new(0, 5.5, 0) })
inner.Parent = model
local from = base + Vector3.new(0, 20, 0)
check("hits the first part", function()
	local hit, distance = M.groundBelow(from, {})
	expect(hit == roof, "hit " .. tostring(hit))
	expect(distance and near(distance, 9, 0.05), "distance " .. tostring(distance))
end)
check("ignores listed instances and their descendants", function()
	local hit, distance = M.groundBelow(from, { roof, model })
	expect(hit == floor, "hit " .. tostring(hit))
	expect(distance and near(distance, 20, 0.05), "distance " .. tostring(distance))
end)
check("nil when nothing is below", function()
	local hit = M.groundBelow(Vector3.new(9000, 4000, 9000), {})
	expect(hit == nil, "hit " .. tostring(hit))
end)
