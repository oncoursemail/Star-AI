local Shop = solution()
local player = testPlayer()
local shop = Shop.new({ sword = 50, shield = 80 })
player:SetAttribute("Coins", 100)
check("buys an item", function()
	local ok, why = shop:buy(player, "sword")
	expect(ok == true and type(why) == "string", "buy sword failed: " .. tostring(why))
	expect(player:GetAttribute("Coins") == 50, "coins " .. tostring(player:GetAttribute("Coins")))
	expect(player:GetAttribute("Owns_sword") == true, "not owned")
end)
check("cannot buy twice", function()
	expect(shop:buy(player, "sword") == false, "bought twice")
	expect(player:GetAttribute("Coins") == 50, "coins changed")
end)
check("not enough coins", function()
	expect(shop:buy(player, "shield") == false, "bought without coins")
	expect(player:GetAttribute("Coins") == 50 and player:GetAttribute("Owns_shield") == nil, "state changed")
end)
check("bad item ids from a client", function()
	for _, bad in { "axe", 5, nil, {}, true, 0 / 0, "__index", "" } do
		local ok, result = pcall(function() return shop:buy(player, bad) end)
		expect(ok, "errored on " .. tostring(bad))
		expect(result == false, "accepted " .. tostring(bad))
	end
	expect(player:GetAttribute("Coins") == 50, "coins changed")
end)
