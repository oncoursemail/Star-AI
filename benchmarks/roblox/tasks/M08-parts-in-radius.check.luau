local M = solution()
local c = Vector3.new(3000, 200, 3000)
local a = testPart({ Name = "A", Size = Vector3.new(1, 1, 1), Position = c + Vector3.new(2, 0, 0) })
local b = testPart({ Name = "B", Size = Vector3.new(1, 1, 1), Position = c + Vector3.new(0, 0, -4.5) })
local far = testPart({ Name = "Far", Size = Vector3.new(1, 1, 1), Position = c + Vector3.new(0, 9, 0) })
check("finds near parts sorted", function()
	local found = M.partsInRadius(c, 6)
	expect(#found == 2, "found " .. #found)
	expect(found[1] == a and found[2] == b, "order " .. tostring(found[1]) .. ", " .. tostring(found[2]))
end)
check("exclude list", function()
	local found = M.partsInRadius(c, 6, { a })
	expect(#found == 1 and found[1] == b, "found " .. #found)
end)
check("far part outside", function()
	for _, p in M.partsInRadius(c, 6) do expect(p ~= far, "far part included") end
end)
