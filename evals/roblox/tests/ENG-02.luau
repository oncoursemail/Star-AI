local ret, env = load_answer()
local parseDuration = resolve(ret, env, "parseDuration")
check("1h30m is 5400", parseDuration("1h30m") == 5400)
check("45s is 45", parseDuration("45s") == 45)
check("2m 10s is 130", parseDuration("2m 10s") == 130)
check("a bare 90 is 90 seconds", parseDuration("90") == 90)
check("1h is 3600 and 0s is 0", parseDuration("1h") == 3600 and parseDuration("0s") == 0)
check("an empty string is nil", parseDuration("") == nil)
check("letters only is nil", parseDuration("abc") == nil)
check("an unknown unit is nil", parseDuration("5x") == nil and parseDuration("1h5x") == nil)
check("a non-string is nil", parseDuration(nil) == nil)
