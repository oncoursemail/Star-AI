local Inventory = load_answer()
local inv = Inventory.new()
Inventory.add(inv, "wood", 3)
Inventory.add(inv, "wood", 2)
check("add 3 then 2 gives count 5", Inventory.count(inv, "wood") == 5)
check("remove 6 returns false", Inventory.remove(inv, "wood", 6) == false)
check("failed remove changes nothing", Inventory.count(inv, "wood") == 5)
check("remove 5 returns true", Inventory.remove(inv, "wood", 5) == true)
check("key is removed when the count reaches 0", inv["wood"] == nil)
check("add raises for 0, -1 and 1.5", throws(Inventory.add, inv, "a", 0) and throws(Inventory.add, inv, "a", -1) and throws(Inventory.add, inv, "a", 1.5))
check("count of an unknown item is 0", Inventory.count(inv, "nothing") == 0)
