    <Item class="Folder">
      <Properties><string name="Name">Logic</string></Properties>
      <Item class="Script">
        <Properties>
          <string name="Name">Server</string><bool name="Disabled">false</bool><token name="RunContext">1</token>
          <ProtectedString name="Source"><![CDATA[local storage = game:GetService("ReplicatedStorage")
local remote = storage:WaitForChild("Submit")
local settings = require(script.Parent.Settings)
local function onRequest(player)
    remote:FireClient(player, settings.read())
end
remote.OnServerEvent:Connect(onRequest)
-- game:GetService("NotAService")
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties><string name="Name">Settings</string><ProtectedString name="Source"><![CDATA[local Settings = {}
function Settings.read()
    return "value < limit & valid"
end
return Settings
]]></ProtectedString></Properties>
      </Item>
      <Item class="LocalScript">
        <Properties><string name="Name">Client</string><ProtectedString name="Source">local remote = script.Parent.Remote
remote:FireServer(&quot;ready&quot;)
</ProtectedString></Properties>
      </Item>
    </Item>
  </Item>
</roblox>
